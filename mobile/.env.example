# Public build settings, compiled into the app. Nothing secret goes here.
# Cloud builds (EAS) never read this file: they take these values from
# build.base.env in eas.json, so keep the two in step.

# The FastAPI backend. On a phone, "localhost" is the phone itself: use your
# computer's network address and run the API with --host 0.0.0.0, e.g.
#   uv run uvicorn app.main:app --reload --host 0.0.0.0
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# The website: shared links and part drawings point here.
EXPO_PUBLIC_SITE_URL=http://192.168.1.10:3000

# Optional. International format, digits only. Defaults to 0816 645 6295.
EXPO_PUBLIC_WHATSAPP_NUMBER=

# Native Google sign-in (development and store builds). Without them, and in
# Expo Go, sign-in opens the website in a browser (README: Google sign-in).
# The web client is the website's (the backend's GOOGLE_CLIENT_ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
