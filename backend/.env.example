# Copy to .env. For local development only APP_ENV and DATABASE_URL matter;
# everything else is optional and switches a feature on when set.

# development | production. Production refuses to start without SESSION_SECRET.
APP_ENV=development

# The only database setting. No Supabase API keys anywhere.
#   Local:    postgresql://localhost:5432/decar   (createdb decar)
#   Supabase: Project > Connect > "Session pooler" URI, with your DB password.
DATABASE_URL=postgresql://localhost:5432/decar

# Public URL of the Next.js frontend, no trailing slash.
FRONTEND_URL=http://localhost:3000

# Signs sign-in sessions. Required in production; generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Google sign-in (optional for buyers, required for /admin in production) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI: <FRONTEND_URL>/auth/callback
# Without these, local dev opens /admin to anyone (demo mode).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed into /admin, comma-separated.
ADMIN_EMAILS=

# --- Order emails via Gmail SMTP (optional) ----------------------------------
# GMAIL_APP_PASSWORD is a 16-character app password, not your Gmail password:
# Google Account > Security > 2-Step Verification > App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where new-order alerts go. Defaults to GMAIL_USER.
OWNER_EMAIL=

# Shop WhatsApp number for the link in order emails: digits only, 2348012345678.
WHATSAPP_NUMBER=

# --- Paystack (optional) -----------------------------------------------------
# Leave empty to offer pay-on-collection only.
PAYSTACK_SECRET_KEY=

# --- Part photos on Cloudinary (optional) ------------------------------------
# Cloudinary console > Settings > API Keys > "API environment variable".
# Paste the value only: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Used by `uv run python -m app.photos`. Keep it secret: it can upload and delete.
CLOUDINARY_URL=
