# Copy to .env.local. No keys here: secrets live in backend/.env only.

# Public URL of this site, no trailing slash. Used for OG images, metadata and
# the Google sign-in return address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shop WhatsApp number, international format, digits only (e.g. 2348012345678).
# Empty uses the shop's 0816 645 6295.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# The FastAPI backend. Only the Next.js server calls it, never the browser.
API_URL=http://localhost:8000
